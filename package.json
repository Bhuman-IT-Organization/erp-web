{
  "name": "erp-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "typecheck": "next typegen && node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js .",
    "lint:prune": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --prune-suppressions",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --test",
    "check:arch": "node scripts/check-architecture-lint.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "ui:add": "node scripts/ui-add.mjs",
    "check:ratchet": "node configs/scripts/lint-ratchet.mjs --expect 104",
    "check:cycles": "depcruise src app --config configs/dependency-cruiser.cjs --ignore-known",
    "check:audit": "yarn npm audit --all --recursive --severity high",
    "check:push": "yarn typecheck && yarn test",
    "check": "yarn typecheck && yarn lint && yarn check:ratchet && yarn check:cycles && yarn check:arch && yarn check:brand && yarn format && yarn test && yarn build && yarn check:audit",
    "check:phase": "yarn typecheck && yarn lint && yarn check:ratchet && yarn check:cycles && yarn check:arch && yarn check:brand && yarn format && yarn test:coverage && yarn build && yarn storybook:build && yarn check:a11y && yarn check:audit",
    "postinstall": "node configs/scripts/git-hooks.mjs install"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "axios": "1.20.0",
    "barcode-detector": "3.2.2",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "next-intl": "4.14.5",
    "next-themes": "0.4.6",
    "nuqs": "2.10.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "sonner": "patch:sonner@npm%3A2.0.8#~/.yarn/patches/sonner-npm-2.0.8-7bb43b9b22.patch",
    "swr": "2.5.1",
    "tus-js-client": "4.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@erp/configs": "link:./configs",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsdoc": "63.3.3",
    "happy-dom": "20.14.5",
    "lefthook": "2.1.14",
    "lint-staged": "16.4.0",
    "prettier": "3.9.8",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "resolutions": {
    "@radix-ui/react-select@npm:2.3.7": "patch:@radix-ui/react-select@npm%3A2.3.7#~/.yarn/patches/@radix-ui-react-select-npm-2.3.7-9b5682d4d3.patch",
    "happy-dom@npm:20.14.5": "patch:happy-dom@npm%3A20.14.5#~/.yarn/patches/happy-dom-npm-20.14.5-9f7d327e12.patch",
    "next-intl@npm:4.14.5": "patch:next-intl@npm%3A4.14.5#~/.yarn/patches/next-intl-npm-4.14.5-16148bd526.patch",
    "@storybook/react@npm:10.6.0": "patch:@storybook/react@npm%3A10.6.0#~/.yarn/patches/@storybook-react-npm-10.6.0-1abf9465d8.patch",
    "@radix-ui/react-menu@npm:2.1.24": "patch:@radix-ui/react-menu@npm%3A2.1.24#~/.yarn/patches/@radix-ui-react-menu-npm-2.1.24-b42bfa15f2.patch",
    "sonner@npm:2.0.8": "patch:sonner@npm%3A2.0.8#~/.yarn/patches/sonner-npm-2.0.8-7bb43b9b22.patch"
  }
}

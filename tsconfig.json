{
  "extends": "@erp/configs/tsconfig/next.json",
  "compilerOptions": { "skipLibCheck": true, "paths": { "@/*": ["./src/*"] } },
  "include": [
    "next-env.d.ts",
    "reset.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
